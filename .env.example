# ============================================================
# 龙虾星球共创联盟 - 环境变量配置
# OpenClaw + AnyGen + HeyGen Integration
# 复制此文件为 .env 并填入真实值
# ============================================================

# --- OpenClaw 核心 ---
OPENCLAW_API_KEY=your-openclaw-api-key
WEBHOOK_SECRET=your-webhook-secret
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- LLM Providers ---
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
GEMINI_API_KEY=xxx
DEEPSEEK_API_KEY=sk-xxx
QWEN_API_KEY=sk-xxx

# --- AnyGen Workspace ---
ANYGEN_WORKSPACE_ID=xxx
ANYGEN_API_KEY=xxx
ANYGEN_BASE_URL=https://api.anygen.ai

# --- HeyGen ---
HEYGEN_API_KEY=xxx

# --- CRM ---
CRM_API_URL=https://your-crm.com/api
CRM_API_KEY=xxx

# --- ERP ---
ERP_API_URL=https://your-erp.com/api
ERP_API_KEY=xxx

# --- Shopify ---
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_API_KEY=xxx
SHOPIFY_API_SECRET=xxx

# --- Amazon ---
AMAZON_SELLER_ID=xxx
AMAZON_AUTH_TOKEN=xxx

# --- TikTok Shop ---
TIKTOK_SHOP_ID=xxx
TIKTOK_ACCESS_TOKEN=xxx

# --- WhatsApp Business ---
WHATSAPP_PHONE_ID=xxx
WHATSAPP_ACCESS_TOKEN=xxx
WHATSAPP_BIZ_ID=xxx

# --- Email ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=xxx
SMTP_PASS=xxx

# --- Payment ---
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PAYPAL_CLIENT_ID=xxx
PAYPAL_CLIENT_SECRET=xxx

# --- Storage ---
REDIS_URL=redis://localhost:6379/0
CHROMA_HOST=localhost

# --- Monitoring ---
SLACK_WEBHOOK_URL=https://hooks.slack.com/xxx
ALERT_EMAIL=alerts@lobsterplanet.com
WECHAT_WORK_WEBHOOK=https://qyapi.weixin.qq.com/xxx
